<?xml version="1.0" encoding="utf-8"?>
<!--
  서울 열린데이터광장 실시간 API 는 HTTP(cleartext) 엔드포인트 (v2 C-2).
  Android 9+ 기본 cleartext 차단을 회피하기 위해 해당 호스트만 예외 허용.
  나머지 트래픽은 기본 정책(HTTPS 강제) 유지.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">swopenapi.seoul.go.kr</domain>
    </domain-config>
</network-security-config>
